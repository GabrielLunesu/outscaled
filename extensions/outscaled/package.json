{
	"name": "outscaled",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.143.0"
	},
	"activationEvents": [
		"onStartupFinished",
		"onFileSystem:ws"
	],
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"main": "./dist/extension.js",
	"scripts": {
		"compile": "gulp compile-extension:outscaled",
		"watch": "gulp watch-extension:outscaled",
		"typecheck": "node ../../node_modules/@typescript/native/bin/tsc --project tsconfig.json --noEmit",
		"test": "node test/run.mjs"
	},
	"contributes": {
		"themes": [
			{
				"id": "carbon-candy-matrix-neon-blur",
				"label": "Carbon Candy Matrix Cyber",
				"uiTheme": "vs-dark",
				"path": "./themes/carbon-candy-matrix-neon-blur.json"
			}
		],
		"configurationDefaults": {
			"workbench.colorTheme": "carbon-candy-matrix-neon-blur"
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "outscaled",
					"title": "%container.title%",
					"icon": "$(server-environment)"
				}
			]
		},
		"views": {
			"outscaled": [
				{
					"id": "outscaled.workspaces",
					"name": "%workspaces.title%"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "outscaled.workspaces",
				"contents": "%workspaces.welcome%",
				"when": "!outscaled.hasWorkspaces"
			}
		],
		"commands": [
			{
				"command": "outscaled.workspaces.refresh",
				"title": "%workspaces.refresh%",
				"icon": "$(refresh)"
			},
			{
				"command": "outscaled.switchWorkspace",
				"title": "%workspaces.switch%"
			},
			{
				"command": "outscaled.openGrid",
				"title": "%grid.open%"
			},
			{
				"command": "outscaled.focusTerminal",
				"title": "%grid.focusTerminal%"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "outscaled.workspaces.refresh",
					"when": "view == outscaled.workspaces",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "outscaled.openGrid",
					"when": "view == outscaled.workspaces && viewItem == outscaled.workspace",
					"group": "outscaled"
				}
			],
			"commandPalette": [
				{
					"command": "outscaled.focusTerminal",
					"when": "false"
				}
			]
		},
		"configuration": {
			"title": "Outscaled",
			"properties": {
				"outscaled.notifications.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%notifications.enabled%"
				},
				"outscaled.wsPath": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "%grid.wsPath%"
				}
			}
		}
	},
	"dependencies": {
		"smol-toml": "^1.9.1",
		"ws": "^8.22.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/ws": "^8.18.2"
	}
}
