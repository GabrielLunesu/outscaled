{
	"name": "outscaled",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.143.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"main": "./dist/extension.js",
	"scripts": {
		"compile": "gulp compile-extension:outscaled",
		"watch": "gulp watch-extension:outscaled",
		"typecheck": "node ../../node_modules/@typescript/native/bin/tsc --project tsconfig.json --noEmit",
		"test": "node test/run.mjs"
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "outscaled",
					"title": "%container.title%",
					"icon": "$(server-environment)"
				}
			]
		},
		"views": {
			"outscaled": [
				{
					"id": "outscaled.workspaces",
					"name": "%workspaces.title%"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "outscaled.workspaces",
				"contents": "%workspaces.welcome%",
				"when": "!outscaled.hasWorkspaces"
			}
		],
		"commands": [
			{
				"command": "outscaled.workspaces.refresh",
				"title": "%workspaces.refresh%",
				"icon": "$(refresh)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "outscaled.workspaces.refresh",
					"when": "view == outscaled.workspaces",
					"group": "navigation"
				}
			]
		}
	},
	"dependencies": {
		"smol-toml": "^1.9.1",
		"ws": "^8.22.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/ws": "^8.18.2"
	}
}
