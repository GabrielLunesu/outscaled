#!/bin/sh
# Block commits that contain secrets. Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed, so the commit is blocked." >&2
	echo "Install it (brew install gitleaks) and commit again." >&2
	exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
